<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core package only. Validators are constructed by ValidationFilter, not
         resolved from DI, so FluentValidation.DependencyInjectionExtensions
         buys nothing here (ADR-0011). -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned to latest 2.x: template's transitive 2.0.0 has GHSA-v5pm-xwqc-g5wc,
         and 3.x changes IOpenApiMediaType, breaking the .NET 10 OpenAPI source
         generator. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Explicit to unify EF Core at 10.0.10 (Npgsql's floor is 10.0.4, Design
         brings 10.0.10 — without this the build warns MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
