<Project>

  <!-- Applies to every project under api/. A warning is a failed build, here
       and in CI, so warnings can't pile up unread. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Compose's .NET services (api-tests, the dev overlay's api) set
       SOCIAL_TENNIS_CONTAINER_BUILD=true, and their restore and build output go
       to obj/container/ and bin/container/ (#121). A container run then never
       overwrites the restore that the sandbox's C# language server reads from
       obj/, whose paths would otherwise be the container's (/src/...,
       /root/.nuget/packages). Set here because Microsoft.Common.props reads
       BaseIntermediateOutputPath right after importing this file. -->
  <PropertyGroup Condition="'$(SOCIAL_TENNIS_CONTAINER_BUILD)' == 'true'">
    <BaseIntermediateOutputPath>obj/container/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/container/</BaseOutputPath>
    <!-- The language server's obj/ and bin/ hold generated .cs files; a
         container build must not compile them. (The other way round is
         covered already: obj/** is excluded by default.) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
