# .NET
bin/
obj/
*.user

# Node / Next.js — web/.gitignore (from create-next-app) covers web/ in detail;
# these cover any future JS tooling elsewhere.
node_modules/
.next/

# Local secrets. Compose reads a .env beside docker-compose.yml (e.g. for
# CHROMATIC_PROJECT_TOKEN); it must never be committed (#113).
.env
.env.*

# OS noise
.DS_Store
Thumbs.db

# Claude Code worktrees (#185): .claude/hooks/worktree-create.sh makes them here.
/.claude/worktrees/

# Snapshots and console logs of the Playwright MCP plugin (ADR-0025)
.playwright-mcp/
