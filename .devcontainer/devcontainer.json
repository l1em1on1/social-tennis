{
  "name": "social-tennis",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // docker-in-docker, not docker-outside-of-docker: compose bind mounts are
    // relative (./api:/src), and an inner daemon resolves them against this
    // container's filesystem. Handing them to the host daemon would send it
    // /workspaces/social-tennis/api, which does not exist on a Windows host.
    // The feature sets privileged itself and keeps /var/lib/docker in a named
    // volume, so the image cache survives rebuilds.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [3000, 8080, 5432],
  "remoteEnv": {
    // dotnet global tools (csharp-ls) land here.
    "PATH": "${containerEnv:PATH}:/home/vscode/.dotnet/tools"
  },
  "mounts": [
    // Keeps Claude Code's auth and plugin cache across rebuilds. Plugins
    // themselves come from .claude/settings.json, so a cold volume self-heals.
    {
      "source": "social-tennis-claude-home",
      "target": "/home/vscode/.claude",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
